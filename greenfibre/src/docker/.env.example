# Copy to `.env` in this folder before `docker compose up`.
# NEVER commit real `.env` values.

MONGO_INITDB_ROOT_USERNAME=CHANGE_ME
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Hex strings expected by imgproxy (must match backend IMGPROXY_KEY / IMGPROXY_SALT)
IMGPROXY_KEY=CHANGE_ME_HEX
IMGPROXY_SALT=CHANGE_ME_HEX
