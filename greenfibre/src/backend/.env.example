# GreenFibre Backend — environment configuration
# Copy this file to .env and fill in your values

PORT=5500
HOST=0.0.0.0
NODE_ENV=development

# Database (MongoDB Atlas)
MONGO_DB_NAME=greenfibre
MONGO_URL=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.xxxxxxx.mongodb.net/greenfibre?retryWrites=true&w=majority&appName=Cluster0

# Auth
JWT_SECRET=<your-jwt-secret>
COOKIE_DOMAIN=

# CORS / URLs
CLIENT_ORIGIN=https://greenfibre.org
ADMIN_ORIGIN=https://admin.greenfibre.org
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5500

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Email (Gmail / SMTP via Nodemailer)
USER_EMAIL=<your-gmail>
USER_PASS=<your-gmail-app-password>

# Payments (Razorpay)
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>

# Payments (Easebuzz)
EASEBUZZ_KEY=<your-easebuzz-key>
EASEBUZZ_SALT=<your-easebuzz-salt>
EASEBUZZ_ENV=test

# MinIO
MINIO_BASE_URL=http://localhost:9000
MINIO_INTERNAL_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=<your-minio-password>
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=<your-minio-secret>
MINIO_BUCKET=media

# Imgproxy
IMGPROXY_URL=http://localhost:8080
IMGPROXY_KEY=<your-imgproxy-key>
IMGPROXY_SALT=<your-imgproxy-salt>

# Docker Compose credentials
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=<your-mongo-root-password>
