# GreenFibre Backend — environment template
# Copy to `.env` and fill with real values. NEVER commit real `.env`.

NODE_ENV=development
PORT=5500
HOST=0.0.0.0

# Database (MongoDB)
# Set a full connection string in your private .env (never commit it).
# Example format only (do not use real credentials here):
# mongodb://USER:PASS@127.0.0.1:27017/DB_NAME?authSource=admin
MONGO_URL=

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
COOKIE_DOMAIN=

# CORS / URLs
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Admin seed (optional; used by seed script only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Email (Gmail / SMTP via Nodemailer)
USER_EMAIL=your-email@example.com
USER_PASS=YOUR_APP_PASSWORD_NOT_ACCOUNT_PASSWORD

# Company (invoices / emails)
COMPANY_NAME=Green Fibre
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=support@example.com
COMPANY_GST=

# Cloudinary (if used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MinIO
MINIO_BASE_URL=http://localhost:9000
MINIO_INTERNAL_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=media

# Imgproxy (hex strings; must match docker/.env IMGPROXY_KEY / IMGPROXY_SALT)
IMGPROXY_URL=http://localhost:8080
IMGPROXY_KEY=CHANGE_ME_HEX
IMGPROXY_SALT=CHANGE_ME_HEX

# Docker Compose (also used in src/docker/.env — keep in sync for local stacks)
MONGO_INITDB_ROOT_USERNAME=CHANGE_ME
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Payments (Easebuzz)
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test

# Shipping (NimbusPost)
NIMBUSPOST_EMAIL=
NIMBUSPOST_PASSWORD=
WAREHOUSE_NAME=
WAREHOUSE_CONTACT_NAME=
WAREHOUSE_ADDRESS=
WAREHOUSE_CITY=
WAREHOUSE_STATE=
WAREHOUSE_PINCODE=
WAREHOUSE_PHONE=
